{
  "info": {
    "name": "GrandVista API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@grandvista.com\",\"password\":\"Admin@123\"}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Login User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"user@grandvista.com\",\"password\":\"User@123\"}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Get Rooms",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/rooms"
      }
    },
    {
      "name": "Get Available Rooms",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/rooms/available"
      }
    },
    {
      "name": "Create Room (Admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"roomNumber\":\"301\",\"type\":\"Presidential\",\"price\":12000,\"available\":true}"
        },
        "url": "{{baseUrl}}/api/rooms"
      }
    },
    {
      "name": "Create Booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"roomId\":1,\"checkIn\":\"2026-10-01\",\"checkOut\":\"2026-10-02\",\"amount\":4500}"
        },
        "url": "{{baseUrl}}/api/bookings"
      }
    },
    {
      "name": "Pay Booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"amount\":4500,\"method\":\"CARD\"}"
        },
        "url": "{{baseUrl}}/api/payments/1"
      }
    },
    {
      "name": "My Bookings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/my"
      }
    }
  ]
}